# ── Required ──────────────────────────────────────────────────
LLM_PROVIDER=ollama                        # ollama | openai_compatible
OLLAMA_BASE_URL=http://ollama:11434        # or http://host.docker.internal:11434 for host GPU
OLLAMA_MODEL=qwen2.5:7b-instruct          # fallback: qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text

DATABASE_URL=postgresql+asyncpg://lenny:lenny@db:5432/lenny_db
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny
POSTGRES_DB=lenny_db

# ── Optional: cloud LLM (OpenAI-compatible) ───────────────────
OPENAI_COMPAT_BASE_URL=                   # e.g. https://api.openai.com/v1
OPENAI_COMPAT_API_KEY=                    # NEVER commit a real key
OPENAI_COMPAT_MODEL=                      # e.g. gpt-4o-mini

# ── Retrieval tuning ──────────────────────────────────────────
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.30                  # tune on eval set; below = NO_RELEVANT_SOURCES

# ── Performance ───────────────────────────────────────────────
LLM_TIMEOUT_SECONDS=120

# ── App ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
